# Vorlage fuer env/.env (Entwicklung) und env/.env.production (Release).
#
# Die beiden echten Dateien sind ignoriert (siehe app/.gitignore) – hier steht
# nur, welche Schluessel es gibt und was ihr Standard ist. Kopieren:
#
#   Copy-Item env\.env.example env\.env
#
# Gelesen wird nichts davon zur Laufzeit; die Werte gehen beim Bauen mit
# (--dart-define-from-file, siehe lib/env.dart). Ohne die Datei baut alles
# weiter, dann gelten die Standardwerte von dort.

# Beispieldaten beim allerersten Start (AppState._seed in lib/models.dart):
# Aufgaben, Termine und die Willkommensnotiz. Aus heisst: Joe startet leer.
JOE_MOCK_DATA=false

# Sync-Server fuer geteilte Einkaufslisten (server/, siehe server/README.md).
# Leer: dieser Build teilt keine Listen neu; beitreten geht trotzdem, die
# Adresse steht im Link. Lokal mit Docker und Emulator:
#   JOE_SYNC_URL=http://10.0.2.2:8787
JOE_SYNC_URL=
