<?xml version="1.0" encoding="utf-8"?>
<!-- Das Kaestchen um das "N" einer Notiz – dieselbe Marke wie im Kalender der
     App (_NoteBadge: Rahmen im Akzent, Fuellung derselbe Ton mit 16%).
     Weiss gemalt und zur Laufzeit eingefaerbt; SRC_ATOP laesst die
     Deckkraft stehen, aus dem blassen Weiss wird also ein blasser Akzent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#29FFFFFF" />
    <corners android:radius="3dp" />
    <stroke
        android:width="1dp"
        android:color="#FFFFFFFF" />
</shape>
