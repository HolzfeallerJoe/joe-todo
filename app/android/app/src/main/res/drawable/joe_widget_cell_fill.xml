<?xml version="1.0" encoding="utf-8"?>
<!-- Die leichte Einfaerbung eines Tages im kleinsten Raster. Fuer den Punkt
     unter der Zahl ist dort kein Platz – also traegt die Flaeche die Farbe
     des Eintrags, so wie im Kalender der App der ausgewaehlte Tag hinterlegt
     ist (_DayCell: derselbe Ton mit 16%).

     Weiss mit gut einem Fuenftel Deckkraft; eingefaerbt wird zur Laufzeit.
     SRC_ATOP tauscht nur den Farbton und laesst die Deckkraft stehen, aus
     dem blassen Weiss wird also ein blasser Eintragston. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#38FFFFFF" />
    <corners android:radius="3dp" />
</shape>
