<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/joe_widget_bg"
        android:tint="@color/joe_widget_preview_paper"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/joe_widget_appointments_label"
            android:textColor="@color/joe_widget_preview_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Morgen"
            android:textColor="@color/joe_widget_preview_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="●  15:00  Kaffee mit Anna\n\nMo, 17. Aug\n●  09:30  Zahnarzt"
            android:textColor="@color/joe_widget_preview_ink"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
