<?xml version="1.0" encoding="utf-8"?>
<!-- Ein Tag im kleinen Raster (2x2). Gebaut wie die Zelle im Kalender der App
     (_DayCell), aber ohne den Punkt unter der Zahl: eine Wochenzeile ist hier
     knapp 14dp hoch, und die Zahl soll die volle Groesse behalten. Was
     ansteht, sagt darum die Flaeche – der Tag ist in der Farbe des Eintrags
     hinterlegt, so wie in der App der ausgewaehlte Tag. Der heutige Tag steht
     wie dort in einem Rahmen.

     Hoehe match_parent mit minHeight: in einer gewichteten Zeile fuellt die
     Zelle, was da ist, in einer wrap_content-Zeile gibt minHeight ihr eine
     verlaessliche Hoehe. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:minHeight="14dp">

    <!-- Der Rand laesst zwei markierte Tage nebeneinander noch als zwei
         Flecken erkennen und nicht als durchgehendes Band. -->
    <ImageView
        android:id="@+id/joe_cell_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:src="@drawable/joe_widget_cell_fill"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/joe_cell_today"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/joe_widget_today_small"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/joe_cell_day"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="11sp" />

    <!-- Die Notiz in der Ecke: das Kaestchen der Marke aus der App, ohne das
         "N" – bei drei Pixeln ist ein Buchstabe nur noch ein Fleck. -->
    <ImageView
        android:id="@+id/joe_cell_note"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:src="@drawable/joe_widget_note"
        android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>
