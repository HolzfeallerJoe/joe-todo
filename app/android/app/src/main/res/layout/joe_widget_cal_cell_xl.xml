<?xml version="1.0" encoding="utf-8"?>
<!-- Ein Tag im grossen Raster: dieselbe Zelle wie mittel, nur mit Platz fuer
     eine groessere Zahl, einen groesseren Punkt und die Notiz als gerahmtes
     "N" – dort ist das Kaestchen so gross wie in der App, also auch so
     lesbar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:minHeight="36dp"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:paddingTop="2dp">

    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="22dp">

        <ImageView
            android:id="@+id/joe_cell_today"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/joe_widget_today"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/joe_cell_day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="11dp"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/joe_cell_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:src="@drawable/joe_widget_dot"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <!-- Das "N" der App: Kaestchen und Buchstabe sind zwei Ansichten,
             weil RemoteViews nur einem ImageView eine Farbe geben kann – der
             Rahmen wird eingefaerbt, die Schrift bekommt sie gesetzt. -->
        <FrameLayout
            android:id="@+id/joe_cell_note"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="3dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/joe_cell_note_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/joe_widget_note_badge"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/joe_cell_note_letter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/joe_widget_note_mark"
                android:textSize="7sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
