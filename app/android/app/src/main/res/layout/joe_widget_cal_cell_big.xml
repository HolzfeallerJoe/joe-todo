<?xml version="1.0" encoding="utf-8"?>
<!-- Ein Tag im mittleren Raster: Zahl oben, darunter der Punkt in der Farbe
     des Eintrags – wie im Kalender der App.

     Der Inhalt sitzt oben und nicht in der Mitte: eine Wochenzeile wird so
     hoch, wie das Widget hergibt, und ein in der Mitte schwebendes Datum
     verliert dabei den Bezug zu seiner Zeile.

     Der Rahmen fuer heute umschliesst nur die Zahl. In der App umschliesst er
     die ganze Zelle, aber die ist dort fast quadratisch; hier wird die Zeile
     schnell doppelt so hoch wie breit, und ein Rahmen um die ganze Hoehe
     saehe aus wie ein leerer Kasten mit einer Zahl obendrin. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:minHeight="26dp"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:paddingTop="2dp">

    <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp">

        <ImageView
            android:id="@+id/joe_cell_today"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/joe_widget_today"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/joe_cell_day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- Punkt und Notizzeichen, beide nur da, wenn es sie gibt (gone, nicht
         invisible): sonst sitzt der Punkt an einem Tag ohne Notiz neben der
         Mitte statt unter der Zahl. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="5dp"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/joe_cell_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:src="@drawable/joe_widget_dot"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/joe_cell_note"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="3dp"
            android:src="@drawable/joe_widget_note"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
