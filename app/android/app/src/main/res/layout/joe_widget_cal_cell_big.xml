<?xml version="1.0" encoding="utf-8"?>
<!-- Ein Tag im mittleren Raster: dieselbe Zelle wie klein, nur mit Platz fuer
     den Punkt unter der Zahl – wie im Kalender der App. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:minHeight="25dp"
    android:orientation="vertical"
    android:gravity="center">

    <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp">

        <ImageView
            android:id="@+id/joe_cell_today"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/joe_widget_dot"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/joe_cell_day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="11sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="14dp"
        android:layout_height="7dp"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/joe_cell_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:src="@drawable/joe_widget_dot"
            android:visibility="invisible"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/joe_cell_note"
            android:layout_width="6dp"
            android:layout_height="7dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="N"
            android:textSize="6sp"
            android:textStyle="bold"
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
