<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2, nur der Monat. Groesser gezogen wechselt das Raster von selbst auf
     die grossen Zellen mit Punkt unter der Zahl (JoeWidgetViews.kt). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/joe_widget_calendar"
    android:previewLayout="@layout/joe_widget_calendar_preview"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/joe_widget_calendar_description"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
